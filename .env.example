# Atlas fields below may be placed in a private root .env file. Other fields
# shown here are process environment variables or configured through Settings.
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# SCOUT_API_KEY must be >=24 chars if overridden. Generated automatically otherwise.
# SCOUT_DATA_DIR=/absolute/path/to/private/data

# Optional Atlas inspection history. Process environment overrides .env.
# Paste the cluster URI without credentials, or Atlas's placeholder URI.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=scout
# Opt-in real database test (writes synthetic records, deletes only its own IDs):
# MONGODB_TEST_URI=
# MONGODB_TEST_DB=scout_test
