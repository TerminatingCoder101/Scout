# Optional process environment; the Settings screen is the default setup path.
# Do not commit real credentials. scripts/run.py uses the existing process env,
# or configure .scout/settings.json via the app. No dotenv loading is assumed.
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# SCOUT_API_KEY must be >=24 chars if overridden. Generated automatically otherwise.
# SCOUT_DATA_DIR=/absolute/path/to/private/data

# Optional Atlas inspection history. Leave URI empty to keep using local Scout.
# Set these in the backend process environment; no dotenv loader is assumed.
MONGODB_URI=
MONGODB_DB=scout
# Opt-in real database test (writes synthetic records, deletes only its own IDs):
# MONGODB_TEST_URI=
# MONGODB_TEST_DB=scout_test
